      "credentials": {
        "gmailOAuth2": {
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const now = DateTime.now().setZone('Asia/Kolkata');\n\n// only alert during working hours (9 am – 9 pm)\nif (now.hour < 9 || now.hour >= 21) return [];\n\nconst overdue = $input.all().map(i => i.json).filter(r => {\n  if (String(r.status || '').trim().toLowerCase() !== 'new') return false;\n  const d = DateTime.fromFormat(String(r.created_at || ''), 'd MMM yyyy, HH:mm', { zone: 'Asia/Kolkata' });\n  if (!d.isValid) return false;\n  const mins = now.diff(d, 'minutes').minutes;\n  return mins >= 60 && mins <= 24 * 60;   // waiting 1–24 hours\n});\n\n// nothing overdue → stop here, no email\nif (overdue.length === 0) return [];\n\nconst rows = overdue.map(r =>\n  `<li><b>${r.name}</b> · ${r.phone} · ${r.course || ''} · waiting since ${r.created_at} · ` +\n  `<a href=\"https://wa.me/91${r.phone}\">WhatsApp now</a></li>`\n).join('');\n\nreturn [{ json: { count: overdue.length, rows } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
