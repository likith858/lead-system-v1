    {
      "parameters": {
        "jsCode": "const d = $input.item.json;\n\n// keep only digits: \"+91 98765-43210\" -> \"919876543210\"\nlet phone = String(d.Phone || '').replace(/\\D/g, '');\n\n// remove India code 91 if they added it\nif (phone.length === 12 && phone.startsWith('91')) {\n  phone = phone.slice(2);\n}\n\n// quality check: flag numbers the counsellor shouldn't trust\nconst issues = [];\nif (phone.length !== 10) issues.push('phone not 10 digits');\nelse if (!/^[6-9]/.test(phone)) issues.push('phone must start with 6-9');\nif (/^(\\d)\\1{9}$/.test(phone) || phone === '1234567890') issues.push('fake-looking number');\n\nreturn {\n  json: {\n    Name: String(d.Name || '').trim(),\n    Phone: phone,\n    Email: String(d.Email || '').trim().toLowerCase(),\n    Course: d.Course,\n    Source: d['How did you hear about us?'] || 'Unknown',\n    data_quality: issues.length ? 'Check: ' + issues.join(', ') : 'OK',\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
