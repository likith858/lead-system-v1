    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst now = DateTime.now().setZone('Asia/Kolkata');\nconst since = now.minus({ days: 7 });\n\n// keep only leads created in the last 7 days\nconst recent = rows.filter(r => {\n  const d = DateTime.fromFormat(String(r.created_at || ''), 'dd MMM yyyy, HH:mm', { zone: 'Asia/Kolkata' });\n  return d.isValid && d >= since;\n});\n\n// count leads by any column, e.g. source or status\nconst countBy = (key) => recent.reduce((acc, r) => {\n  const k = String(r[key] || '').trim() || 'Unknown';\n  acc[k] = (acc[k] || 0) + 1;\n  return acc;\n}, {});\n\nconst toRows = (obj) => Object.keys(obj).length === 0\n  ? '<tr><td style=\"padding:4px 12px\" colspan=\"2\">No leads this week</td></tr>'\n  : Object.entries(obj)\n      .sort((a, b) => b[1] - a[1])\n      .map(([k, v]) => `<tr><td style=\"padding:4px 12px\">${k}</td><td style=\"padding:4px 12px\">${v}</td></tr>`)\n      .join('');\n\nreturn [{ json: {\n  total: recent.length,\n  joined: recent.filter(r => String(r.status).trim().toLowerCase() === 'joined').length,\n  sourceRows: toRows(countBy('source')),\n  statusRows: toRows(countBy('status')),\n  period: `${since.toFormat('dd MMM')} – ${now.toFormat('dd MMM yyyy')}`\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "efe69976-1939-4774-8d4f-2487ca331dd4",
      "name": "Build Report"
    },
    {
      "parameters": {
        "sendTo": "owner@example.com",
        "subject": "=Weekly report: {{ $('Build Report').first().json.total }} new leads ({{ $('Build Report').first().json.period }})",
        "message": "=<p>Hi [Owner name],</p>\n<p>Here is your lead summary for <b>{{ $('Build Report').first().json.period }}</b>.</p>\n\n<p><b>New leads:</b> {{ $('Build Report').first().json.total }} &nbsp;·&nbsp; <b>Joined a batch:</b> {{ $('Build Report').first().json.joined }}</p>\n\n<p><b>Where leads came from</b></p>\n<table border=\"1\" style=\"border-collapse:collapse;font-family:Arial;font-size:14px\">\n  <tr style=\"background:#e6f2ef\"><td style=\"padding:4px 12px\"><b>Source</b></td><td style=\"padding:4px 12px\"><b>Leads</b></td></tr>\n  {{ $('Build Report').first().json.sourceRows }}\n</table>\n\n<p><b>Lead status</b></p>\n<table border=\"1\" style=\"border-collapse:collapse;font-family:Arial;font-size:14px\">\n  <tr style=\"background:#e6f2ef\"><td style=\"padding:4px 12px\"><b>Status</b></td><td style=\"padding:4px 12px\"><b>Leads</b></td></tr>\n  {{ $('Build Report').first().json.statusRows }}\n</table>\n\n<p><b>Money this week</b></p>\n<table border=\"1\" style=\"border-collapse:collapse;font-family:Arial;font-size:14px\">\n  <tr><td style=\"padding:4px 12px\">Spent on ads</td><td style=\"padding:4px 12px\"><b>{{ $('Pick money numbers').first().json.spend }}</b></td></tr>\n  <tr><td style=\"padding:4px 12px\">Cost per enquiry</td><td style=\"padding:4px 12px\"><b>{{ $('Pick money numbers').first().json.cpl }}</b></td></tr>\n  <tr><td style=\"padding:4px 12px\">Enquiries who booked a review</td><td style=\"padding:4px 12px\"><b>{{ $('Pick money numbers').first().json.bookedRate }}</b></td></tr>\n  <tr><td style=\"padding:4px 12px\">Cost per student who joined</td><td style=\"padding:4px 12px\"><b>{{ $('Pick money numbers').first().json.costPerJoined }}</b></td></tr>\n</table>\n\n<p>Reply to this email if you'd like to go through any of these numbers together.</p>\n<p>Likith D</p>",
        "options": {
          "appendAttribution": false
        }
      },
