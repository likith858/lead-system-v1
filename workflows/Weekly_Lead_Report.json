    {
      "parameters": {
        "jsCode": "// 1. Find a row by the start of its Metric name and turn its Total into a number\nconst rows = $input.all().map(i => i.json);\nconst total = (name) => {\n  const row = rows.find(r => String(r.Metric || '').startsWith(name));\n  if (!row || row.Total === '' || row.Total == null) return null;\n  const n = Number(String(row.Total).replace(/[₹,%\\s]/g, ''));\n  return isNaN(n) ? null : n;\n};\n\n// 2. Format numbers the way a client reads them\nconst rupees = (n, decimals = 0) =>\n  n === null ? 'not available'\n  : '₹' + n.toLocaleString('en-IN', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });\nconst percent = (n) =>\n  n === null ? 'not available'\n  : (n <= 1 ? n * 100 : n).toFixed(1) + '%';\n\n// 3. The 4 money numbers for the email\nreturn [{\n  json: {\n    spend: rupees(total('Spend')),\n    cpl: rupees(total('CPL'), 1),\n    bookedRate: percent(total('Booked rate')),\n    costPerJoined: rupees(total('Cost per joined')),\n  }\n}];"
      },
